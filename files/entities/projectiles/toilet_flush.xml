<Entity tags="hittable,teleportable_NOT,item_physics,projectile,mod_toilet" >

	<!-- Lobbed physics toilet, modeled on vanilla TNTBOX (data/entities/projectiles/deck/tntbox.xml).
	     The projectile IS the toilet: it lands as a physics prop and toilet_update.lua does the flushing. -->
	<Base file="data/entities/base_projectile_physics.xml">

		<PhysicsBodyComponent
			_tags="enabled_in_world"
			hax_fix_going_through_ground="0"
			projectiles_rotate_toward_velocity="0"
			on_death_leave_physics_body="0"
		></PhysicsBodyComponent>

		<PhysicsImageShapeComponent
			image_file="mods/noita_toilet_flush/files/sprites/toilet_projectile.png"
			material="wood_prop_noplayerhit"
		></PhysicsImageShapeComponent>

		<PhysicsThrowableComponent
			_tags="enabled_in_world"
			attach_to_surfaces_knife_style="0"
			throw_force_coeff="0.75"
		></PhysicsThrowableComponent>

		<ProjectileComponent
			_tags="enabled_in_world"
			lifetime="1800"
			lob_min="0.7"
			lob_max="1.0"
			speed_min="160"
			speed_max="190"
			on_collision_die="0"
			on_death_explode="0"
			on_lifetime_out_explode="0"
			on_death_gfx_leave_sprite="0"
			damage="0"
			muzzle_flash_file="data/entities/particles/muzzle_flashes/muzzle_flash_launcher_large.xml"
			shoot_light_flash_radius="96"
			shoot_light_flash_r="180"
			shoot_light_flash_g="220"
			shoot_light_flash_b="255"
			do_moveto_update="1"
		></ProjectileComponent>

		<DamageModelComponent
			_tags="enabled_in_world"
			air_needed="0"
			blood_material=""
			drop_items_on_death="0"
			falling_damages="0"
			fire_damage_amount="0"
			fire_probability_of_ignition="0"
			critical_damage_resistance="1"
			hp="8"
			is_on_fire="0"
			materials_create_messages="0"
			materials_damage="0"
			ragdoll_filenames_file=""
			ragdoll_material=""
			blood_multiplier="0"
			ui_report_damage="0"
		></DamageModelComponent>

	</Base>

	<GenomeDataComponent
		herd_id="player"
	></GenomeDataComponent>

	<!-- The toilet drinks nearby liquids (pattern from vanilla vacuum_liquid.xml).
	     Everything it swallows spills back out when it dies. Plumbing is temporary. -->
	<MaterialSuckerComponent
		num_cells_sucked_per_frame="60"
		randomized_position.min_x="-48"
		randomized_position.max_x="48"
		randomized_position.min_y="-48"
		randomized_position.max_y="48"
		material_type="0"
		barrel_size="15000"
	></MaterialSuckerComponent>

	<MaterialInventoryComponent
		drop_as_item="0"
		on_death_spill="1"
	></MaterialInventoryComponent>

	<LuaComponent
		script_source_file="mods/noita_toilet_flush/files/scripts/toilet_update.lua"
		execute_every_n_frame="2"
	></LuaComponent>

	<AudioComponent
		file="data/audio/Desktop/projectiles.bank"
		event_root="player_projectiles/throwable"
	></AudioComponent>

</Entity>
