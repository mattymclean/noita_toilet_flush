<Entity tags="wand">

	<!-- Testing wand pre-loaded with the Toilet Flush spell.
	     Structure copied from the starting_loadouts mod that ships with Noita. -->

	<AbilityComponent
		_enabled="1"
		sprite_file="mods/noita_toilet_flush/files/entities/toilet_wand_sprite.xml"
		swim_propel_amount="0"
		ui_name="Flusher 3000"
		drop_as_item_on_death="0"
		cooldown_frames="1"
		entity_count="1"
		reload_time_frames="0"
		mana_charge_speed="60"
		mana_max="200"
		use_gun_script="1"
		>
		<gun_config
			shuffle_deck_when_empty="0"
			reload_time="20"
			deck_capacity="3" >
		</gun_config>
		<gunaction_config
			fire_rate_wait="40" >
		</gunaction_config>
	</AbilityComponent>

	<HotspotComponent
		_tags="shoot_pos"
		offset.x="12"
		offset.y="-2" >
	</HotspotComponent>

	<Base file="data/entities/base_item.xml" >
		<ItemComponent
			item_name="Flusher 3000"
			remove_on_death="1"
			collect_nondefault_actions="1" >
		</ItemComponent>
	</Base>

	<LuaComponent
		execute_on_added="1"
		remove_after_executed="1"
		script_source_file="mods/noita_toilet_flush/files/scripts/toilet_wand_setup.lua"
		>
	</LuaComponent>

	<Base file="data/entities/base_wand_pickup.xml" > <LuaComponent _enabled="0" script_item_picked_up="" /> </Base>

	<ManaReloaderComponent
		_tags="enabled_in_world,enabled_in_hand,enabled_in_inventory" >
	</ManaReloaderComponent>

</Entity>
